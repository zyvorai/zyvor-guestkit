[workspace]
members = [
    ".",
    "crates/guestkit-job-spec",
]
resolver = "2"

[workspace.package]
authors = ["ZyvorAI Labs Private Limited <info@zyvor.dev>"]
license = "LicenseRef-Zyvor-Production-2.0"
edition = "2024"
repository = "https://github.com/hypersdk/guestkit"

[workspace.dependencies]
# Shared dependencies
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
thiserror = "2.0"
anyhow = "1.0"
chrono = { version = "0.4", features = ["serde"] }

[package]
name = "guestkit"
version = "0.3.1"
edition.workspace = true
authors.workspace = true
license.workspace = true
description = "Pure Rust VM disk toolkit with beautiful output, Windows registry parsing, and VM migration support"
repository.workspace = true
keywords = ["virtualization", "vm", "disk", "qemu", "kvm"]
categories = ["virtualization", "filesystem", "command-line-utilities"]

[dependencies]
# Workspace crates
guestkit-job-spec = { path = "crates/guestkit-job-spec", optional = true }

# Core
anyhow.workspace = true
thiserror.workspace = true
log = "0.4"
env_logger = "0.11"

# Async runtime
tokio = { version = "1", features = ["full"] }

# Serialization
serde.workspace = true
serde_json.workspace = true
serde_yaml = "0.9"
toml = "0.8"
csv = "1.3"

# CLI
clap = { version = "4", features = ["derive", "cargo"] }
clap_complete = "4.5"
indicatif = "0.18"
miette = { version = "7.0", features = ["fancy"] }
owo-colors = "4.0"
colored = "3.1"
unicode-width = "0.2"
rustyline = "17.0"
dirs = "6.0"
rpassword = "7.3"

# AI Assistant (optional feature)
rig-core = { version = "0.29", optional = true }
reqwest = { version = "0.12", optional = true }

# TUI
ratatui = "0.28"
crossterm = "0.28"

# Utilities
rand = "0.8"
uuid = { version = "1.0", features = ["v4", "serde"] }
chrono.workspace = true
tempfile = "3.0"

# Disk image and partition parsing (pure Rust)
memmap2 = "0.9"
byteorder = "1.5"

# Regex for OS detection
regex = "1"

# Glob for pattern matching
glob = "0.3"

# Base64 encoding/decoding
base64 = "0.22"

# Unix system calls for privilege checking
libc = "0.2"

# Windows registry parsing (pure Rust)
nt_hive2 = "4.2"

# Report generation and export
printpdf = "0.7"

# Hashing for cache keys
sha2 = "0.10"

# Binary serialization for fast caching
bincode = "1.3"

# Parallel processing
rayon = "1.8"

# PyO3 for Python bindings (optional)
pyo3 = { version = "0.27", features = ["extension-module"], optional = true }

[dev-dependencies]
tokio-test = "0.4"
mockall = "0.14"
tempfile = "3.0"
assert_cmd = "2.0"
predicates = "3.0"
criterion = { version = "0.8", features = ["html_reports"] }
proptest = "1.4"
num_cpus = "1.16"

[features]
default = ["disk-ops", "guest-inspect"]
disk-ops = []
guest-inspect = []
python-bindings = ["pyo3"]
ai = ["rig-core", "reqwest"]
job-protocol = ["guestkit-job-spec"]

# Python module (optional)
[lib]
name = "guestkit"
crate-type = ["rlib", "cdylib"]

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
strip = true

[profile.dev]
opt-level = 0
debug = true

[[bench]]
name = "operations"
harness = false

[[bench]]
name = "performance"
harness = false
